-- Функция получения списка гонок
local function races()
    local tab = {"None"}
    if workspace:FindFirstChild("Races") then
        for i,v in pairs(workspace.Races:GetChildren()) do
            if v:IsA("Model") then
                table.insert(tab, v.Name)
            end
        end
    end
    return tab
end

