        dropdown.Position = UDim2.new(0, 5, 0, 3)
        dropdown.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        dropdown.Text = options[1] or "None"
        dropdown.TextColor3 = Color3.fromRGB(255,255,255)
        dropdown.TextSize = 14
        dropdown.Font = Enum.Font.SourceSans
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = dropdown

        local listVisible = false
        local listFrame = Instance.new("Frame")
        listFrame.Parent = frame
        listFrame.Size = UDim2.new(1, -10, 0, 0)
        listFrame.Position = UDim2.new(0, 5, 0, 35)
        listFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        listFrame.BorderSizePixel = 0
        listFrame.Visible = false
        local listCorner = Instance.new("UICorner")
        listCorner.CornerRadius = UDim.new(0, 4)
        listCorner.Parent = listFrame

        local listLayout = Instance.new("UIListLayout")
        listLayout.Parent = listFrame
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 2)

        local function refreshList()
            for _, child in pairs(listFrame:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            local height = 0
            for _, opt in ipairs(options) do
                local btn = Instance.new("TextButton")
                btn.Parent = listFrame
                btn.Size = UDim2.new(1, 0, 0, 25)
                btn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
                btn.Text = opt
                btn.TextColor3 = Color3.fromRGB(255,255,255)
                btn.TextSize = 13
                btn.Font = Enum.Font.SourceSans
                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 4)
                btnCorner.Parent = btn
                btn.MouseButton1Click:Connect(function()
                    dropdown.Text = opt
                    callback(opt)
                    listVisible = false
                    listFrame.Visible = false
                    listFrame.Size = UDim2.new(1, -10, 0, 0)
                end)
                height = height + 27
            end
            listFrame.Size = UDim2.new(1, -10, 0, height)
        end
        refreshList()

        dropdown.MouseButton1Click:Connect(function()
            listVisible = not listVisible
            listFrame.Visible = listVisible
            if listVisible then
                refreshList()
            end
        end)
        return dropdown
    end

    local function AddButton(text, callback)
        local btn = Instance.new("TextButton")
        btn.Parent = contentFrame
        btn.Size = UDim2.new(1, 0, 0, 35)
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.TextSize = 15
        btn.Font = Enum.Font.SourceSansBold
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    -- Табы
    local function switchTab(index)
        for i, v in pairs(tabButtons) do
            if i == index then
                v.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
                v.TextColor3 = Color3.fromRGB(255,255,255)
            else
                v.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
                v.TextColor3 = Color3.fromRGB(180,180,180)
            end
        end
        for _, child in pairs(contentFrame:GetChildren()) do
            if child:IsA("UIListLayout") == false then
                child:Destroy()
            end
        end
        -- Содержимое каждого таба будет заполняться отдельно
    end

    for i, tabName in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Parent = tabBar
        btn.Size = UDim2.new(1 / #tabs, -2, 1, 0)
        btn.Position = UDim2.new((i-1) / #tabs, 1, 0, 0)
        btn.BackgroundColor3 = (i == 1) and Color3.fromRGB(60, 60, 90) or Color3.fromRGB(25, 25, 40)
        btn.Text = tabName
        btn.TextColor3 = (i == 1) and Color3.fromRGB(255,255,255) or Color3.fromRGB(180,180,180)
        btn.TextSize = 14
        btn.Font = Enum.Font.SourceSans
        btn.BorderSizePixel = 0
        btn.Name = "Tab" .. tabName
        btn.MouseButton1Click:Connect(function()
            switchTab(i)
        end)
        tabButtons[i] = btn
    end

    -- Возвращаем функции для добавления элементов в текущий таб
    local api = {
        AddLabel = AddLabel,
        AddBox = AddBox,
        AddToggle = AddToggle,
        AddDropdown = AddDropdown,
        AddButton = AddButton,
        switchTab = switchTab,
        contentFrame = contentFrame,
        tabButtons = tabButtons
    }
    return api, mainFrame
end

