CreateToggle("Auto Farm Miles", function(state)
    getfenv().autoFarm = state
    if state then
        task.spawn(function()
            while getfenv().autoFarm do
                task.wait()
                pcall(function()
                    local chr = game.Players.LocalPlayer.Character
                    if chr and chr:FindFirstChild("Humanoid") and chr.Humanoid.SeatPart then
                        local car = chr.Humanoid.SeatPart.Parent.Parent
                        if not workspace:FindFirstChild("justapart") then
                            local new = Instance.new("Part", workspace)
                            new.Name = "justapart"
                            new.Size = Vector3.new(10000, 20, 10000)
                            new.Anchored = true
                            new.Position = chr.HumanoidRootPart.Position + Vector3.new(0, 1000, 0)
                        end
                        car:PivotTo(workspace:FindFirstChild("justapart").CFrame * CFrame.new(0, 10, 1000))
                        local pos = workspace:FindFirstChild("justapart").CFrame * CFrame.new(0, 10, -1000)
                        local dist = (car.PrimaryPart.Position - pos.Position).magnitude
                        local spd = getfenv().speed or 1000
                        
                        car.PrimaryPart.AssemblyLinearVelocity = car.PrimaryPart.CFrame.LookVector * spd
                        local TweenService = game:GetService("TweenService")
                        local TweenInfoToUse = TweenInfo.new(dist/spd, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 0, true, 0)
                        local TweenValue = Instance.new("CFrameValue")
                        TweenValue.Value = car.WorldPivot
                        TweenValue.Changed:Connect(function()
                            car.PrimaryPart.AssemblyLinearVelocity = car.PrimaryPart.CFrame.LookVector * spd
                            car:PivotTo(TweenValue.Value)
                        end)
                        local OnTween = TweenService:Create(TweenValue, TweenInfoToUse, {Value = pos})
                        OnTween:Play()
                        OnTween.Completed:Wait()
                    end
                end)
            end
        end)
    end
end)

CreateToggle("Auto Open Deluxe/Normal Kits", function(state)
    getfenv().autoKits = state
    if state then
        task.spawn(function()
            while getfenv().autoKits do
                pcall(function()
                    local consume = game:GetService("ReplicatedStorage").Remotes.Services.ConsumableServiceRemotes.Consume
                    local kits = {"DecorationKitDeluxe", "DecorationKit", "DeluxeCustomizationKit", "CustomizationKit"}
                    for _, kit in ipairs(kits) do
                        if not getfenv().autoKits then break end
                        consume:InvokeServer(kit)
                        task.wait(0.1)
                    end
                end)
                task.wait(0.5)
            end
        end)
    end
end)

