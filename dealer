local tabFillers = {
    fillMainTab,
    fillDeliveryTab,
    fillRaceTab,
    fillAutomationTab,
    fillMiscTab
}

-- Переопределим switchTab, чтобы она вызывала нужный загрузчик
local originalSwitch = ui.switchTab
ui.switchTab = function(index)
    originalSwitch(index)
    currentTab = index
    -- Очищаем контент
    local content = ui.contentFrame
    for _, child in pairs(content:GetChildren()) do
        if child:IsA("UIListLayout") == false then
            child:Destroy()
        end
    end
    -- Вызываем загрузчик таба
    if tabFillers[index] then
        tabFillers[index]()
    end
end

