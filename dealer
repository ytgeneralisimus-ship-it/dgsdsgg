        task.wait(0.1)
        chatScroll.CanvasPosition = Vector2.new(0, chatScroll.CanvasSize.Y.Offset)
    end

    -- Функция получения контекста игры
    local function getGameContext()
        local plr = game.Players.LocalPlayer
        local context = {}
        table.insert(context, "Игрок: " .. plr.Name)
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local pos = plr.Character.HumanoidRootPart.Position
            table.insert(context, "Позиция: " .. string.format("%.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z))
        end
        if plr.Character and plr.Character:FindFirstChild("Humanoid") then
            local hum = plr.Character.Humanoid
            table.insert(context, "Здоровье: " .. hum.Health .. "/" .. hum.MaxHealth)
        end
        -- Машина
        if plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.SeatPart then
            local car = plr.Character.Humanoid.SeatPart.Parent.Parent
            table.insert(context, "В машине: " .. car.Name)
            if car:FindFirstChild("PrimaryPart") then
                local speed = car.PrimaryPart.AssemblyLinearVelocity.Magnitude
                table.insert(context, "Скорость: " .. string.format("%.1f", speed))
            end
        end
        -- Деньги
        local money = plr:FindFirstChild("leaderstats") and plr.leaderstats:FindFirstChild("Money")
        if money then
            table.insert(context, "Деньги: " .. money.Value)
        end
        -- Активные задания
        local missionGui = plr.PlayerGui:FindFirstChild("MissionRewardStars")
        if missionGui then
            local stars = 0
            for _, star in pairs(missionGui.Frame.Stars:GetChildren()) do
                if string.find(star.Name, "Star") and star.ImageColor3 == Color3.fromRGB(255, 189, 34) then
                    stars = stars + 1
                end
            end
            table.insert(context, "Звёзд в текущем задании: " .. stars)
        end
        -- Участок
        for _, v in pairs(workspace.Tycoons:GetDescendants()) do
            if v.Name == "Owner" and v:IsA("StringValue") and v.Value == plr.Name then
                table.insert(context, "Владеет участком: " .. v.Parent.Name)
                break
            end
        end
        return table.concat(context, "\n")
    end

    -- Обработчик отправки
    sendBtn.MouseButton1Click:Connect(function()
        local question = inputBox.Text
        if question == "" then return end
        inputBox.Text = ""
        addMessage("Вы: " .. question, true)

        task.spawn(function()
            local apiKey = settings.aiApiKey
            if apiKey == "" then
                addMessage("Ошибка: API ключ не задан.", false)
                return
            end

            local context = getGameContext()
            local prompt = "Ты — ассистент в игре Roblox Vehicle Dealership. Вот текущая информация об игроке:\n" .. context .. "\n\nВопрос игрока: " .. question

            local data = {
                model = settings.aiModel or "gpt-3.5-turbo",
                messages = {
                    {role = "system", content = "Ты полезный ассистент по игре Vehicle Dealership."},
                    {role = "user", content = prompt}
                },
                max_tokens = 500,
                temperature = 0.7
            }

            local jsonData = game:GetService("HttpService"):JSONEncode(data)
            local headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. apiKey
            }

            local success, response = pcall(function()
                return game:GetService("HttpService"):RequestAsync({
                    Url = "https://api.openai.com/v1/chat/completions",
                    Method = "POST",
                    Headers = headers,
                    Body = jsonData
                })
            end)

            if not success then
                addMessage("Ошибка соединения с API.", false)
                return
            end

            if response.Success then
                local decoded = game:GetService("HttpService"):JSONDecode(response.Body)
                local reply = decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content
                if reply then
                    addMessage("ИИ: " .. reply, false)
                    -- Логируем в файл
                    local logEntry = os.date("%Y-%m-%d %H:%M:%S") .. "\nВопрос: " .. question .. "\nОтвет: " .. reply .. "\n---\n"
                    pcall(function()
                        local file = io.open("ai_logs.txt", "a")
                        if file then
                            file:write(logEntry)
                            file:close()
                        end
                    end)
                else
                    addMessage("Ответ от API не распознан.", false)
                end
            else
                addMessage("Ошибка API: " .. response.StatusCode, false)
            end
        end)
    end)

    -- Приветствие
    addMessage("ИИ: Привет! Я помогу тебе с игрой. Задавай вопросы.", false)
end)

